# Endereco da API. No emulador Android use http://10.0.2.2:4444; num aparelho
# fisico, o IP da sua maquina na rede local, ex.: http://192.168.0.10:4444
EXPO_PUBLIC_API_URL=http://localhost:4444
# Endereco do front web (links para configuracoes, termos e privacidade).
EXPO_PUBLIC_WEB_URL=http://localhost:5173
# Opcional: id do Business Manager mostrado na tela de Meta Ads.
EXPO_PUBLIC_META_BUSINESS_ID=
