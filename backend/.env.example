# Modelo do .env. Copie para .env e ajuste. O .env nunca vai para o git.
# Os valores abaixo ja funcionam com um PostgreSQL local (ou com o
# docker-compose da raiz, que passa as mesmas variaveis).

PORT=4444
NODE_ENV=development
TZ=America/Sao_Paulo

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=orbita_crm

# Endereco do front (links de e-mail, NPS, onboarding) e da propria API
# (links de arquivos guardados em disco quando o Bunny nao esta configurado).
APP_WEB_BASE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4444
# Opcional: restringe o CORS (lista separada por virgula). Vazio = qualquer origem
# (a autenticacao e por Bearer token, sem cookies).
CORS_ORIGINS=

# Segredos. Minimo de 32 caracteres. Em producao a API nao sobe sem eles.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Fora de producao, vazios = valores de desenvolvimento (so para rodar local).
SESSION_JWT_SECRET=
PUBLIC_LINK_SECRET=
# Chave AES-256 (64 hex) e IV (32 hex) para o CPF guardado criptografado.
CPF_ENCRYPTION_KEY=
CPF_ENCRYPTION_IV=

# E-mail (SMTP). Vazio = nada sai da maquina: assunto, links e o codigo de
# redefinicao de senha aparecem no console da API.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_EMAIL=contato@example.com

# Armazenamento de arquivos (Bunny Storage). Vazio = disco local em .runtime/media,
# servido pela propria API em /media-local.
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_CDN_HOST=

# IA do atendimento (analise de conversa, sugestao de resposta, correcao de texto).
OPENAI_API_KEY=
OPENAI_ATENDIMENTO_MODEL=gpt-4.1-mini

# WhatsApp Cloud API / Instagram / Meta Ads (opcionais).
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_IG_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_ADS_ACESS_TOKEN=
META_REDIRECT_URI=
META_GRAPH_API_VERSION=v25.0

# Google Ads (opcional).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=

# Stripe (assinatura do SaaS). Sem STRIPE_WEBHOOK_SECRET o webhook recusa tudo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# Integracao com o Gestao 360 (rotas /integracao/gestao360, cabecalho
# x-integration-key). Vazio = rotas desligadas (503).
GESTAO360_INTEGRATION_KEY=
GESTAO360_ASSINATURA_ID=2

# Token para publicar novidades globais por integracao externa (opcional).
NOVIDADES_EXTERNAL_TOKEN=

# Jobs agendados, executados pelo cron do servidor com `npm run cron:<nome>`
# (aniversario, follow-up de venda, sem resposta, disparos agendados,
# encerramento de atendimentos parados, alertas financeiros).
WHATSAPP_BIRTHDAY_TEMPLATE_JOB_ENABLED=true
WHATSAPP_SALES_FOLLOWUP_TEMPLATE_JOB_ENABLED=true
WHATSAPP_NO_REPLY_JOB_ENABLED=true
COMMERCIAL_SCHEDULED_DISPATCH_JOB_ENABLED=true
STALE_ATENDIMENTO_CLOSURE_JOB_ENABLED=true

# Para testar webhooks de desenvolvedor com um receptor na sua maquina.
DEVELOPER_WEBHOOKS_ALLOW_PRIVATE=false
